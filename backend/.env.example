# 本機開發／測試庫用的預設值。填 seeder 帳密（跟 Debby 要，只綁得到 _test，
# 連不到正式庫，安全）；不要在這裡填 app_ro / game_writer / root ——那些是
# 正式站或維運專用，不該出現在任何人的本機 .env。
DB_HOST=43.163.233.40
DB_PORT=31497
DB_USER=seeder
DB_PASSWORD=your_seeder_password_here
DB_WRITE_USER=seeder
DB_WRITE_PASSWORD=your_seeder_password_here
DB_NAME=AttentionLessonPlan_test

API_HOST=127.0.0.1
API_PORT=5001

TEST_DB_NAME=AttentionLessonPlan_test

# 前端跨網域呼叫時要放行其 origin。逗號分隔多個；或填單一 * 放行全部（開發用）。
# 留空 = 只放行常見的本機 dev server（localhost:3000/5173/5500/8080）。
# 前端由本服務一併提供（見 main.py 的 /app 掛載）時，跟 /api/* 同源，
# 不需要設定這個變數。
# 例：CORS_ALLOW_ORIGINS=http://localhost:5173,https://your-frontend.example
CORS_ALLOW_ORIGINS=

# ------------------------------------------------------------------
# 部署到 Zeabur（正式站）才需要以下設定，本機開發不會用到：
#   DB_HOST / DB_PORT 同上（正式庫在同一台伺服器）
#   DB_USER=app_ro          DB_PASSWORD=<app_ro 密碼>
#   DB_WRITE_USER=game_writer   DB_WRITE_PASSWORD=<game_writer 密碼>
#   DB_NAME=AttentionLessonPlan
# 這組帳密只存在於 Zeabur 的環境變數，不進任何人的本機 .env 或這個檔案。
# ------------------------------------------------------------------
